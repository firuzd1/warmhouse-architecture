@startuml
title ER диаграмма - Теплый дом

entity "users" {
    *id: int
    --
    name: varchar
    email: varchar
    password_hash: varchar
    created_at: timestamp
    updated_at: timestamp
}

entity "devices" {
    *id: int
    --
    name: varchar
    type: varchar
    location: varchar
    status: varchar
    user_id: int <<FK>>
    created_at: timestamp
    updated_at: timestamp
}

entity "sensors" {
    *id: int
    --
    name: varchar
    type: varchar
    location: varchar
    value: float
    unit: varchar
    status: varchar
    device_id: int <<FK>>
    last_updated: timestamp
    created_at: timestamp
}

entity "telemetry" {
    *id: int
    --
    sensor_id: int <<FK>>
    value: float
    unit: varchar
    recorded_at: timestamp
}

entity "scenarios" {
    *id: int
    --
    name: varchar
    description: varchar
    user_id: int <<FK>>
    is_active: boolean
    created_at: timestamp
}

entity "scenario_actions" {
    *id: int
    --
    scenario_id: int <<FK>>
    device_id: int <<FK>>
    action: varchar
    parameters: jsonb
}

users ||--o{ devices : "владеет"
users ||--o{ scenarios : "создаёт"
devices ||--o{ sensors : "содержит"
sensors ||--o{ telemetry : "генерирует"
scenarios ||--o{ scenario_actions : "содержит"
scenario_actions }o--|| devices : "управляет"

@enduml